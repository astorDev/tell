<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tell</ToolCommandName>
    <AssemblyName>tell</AssemblyName>
    <PackageId>Tell.Cli</PackageId>
    <RootNamespace>Tell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hesive.Apps" Version="2026.109.126.4" />
    <PackageReference Include="NiceShell.Cli" Version="2026.109.127.20" />
    <PackageReference Include="NiceShell.Logger" Version="2026.110.126.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.CommandLine" />
    <Using Include="NiceShell" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\make\lib\Tell.Makefile.csproj" />
    <ProjectReference Include="..\lib\Tell.Cli.Lib.csproj" />
    <ProjectReference Include="..\..\positional\lib\Tell.Positional.csproj" />
    <ProjectReference Include="..\..\small\fallback\lib\Tell.Fallback.csproj" />
  </ItemGroup>

</Project>
