<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tell</ToolCommandName>
    <RootNamespace>Tell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hesive.Apps" Version="2026.109.122.2" />
    <PackageReference Include="NiceShell.Cli" Version="2026.108.104.12" />
    <PackageReference Include="NiceShell.Logger" Version="2026.109.119.9" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.CommandLine" />
    <Using Include="NiceShell" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\make\lib\Tell.Makefile.csproj" />
  </ItemGroup>

</Project>
